# Copy to .env (or run: python scripts/setup_env.py to generate one with fresh keys)
ENVIRONMENT=development
WEB_BASE_URL=http://localhost:3100
CORS_ORIGINS=["http://localhost:3100"]

DATABASE_URL=postgresql+asyncpg://companyos_app:companyos_app_dev@localhost:5442/companyos
MIGRATION_DATABASE_URL=postgresql+asyncpg://companyos:companyos_dev@localhost:5442/companyos
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=companyos
S3_SECRET_KEY=companyos_dev_secret
S3_BUCKET=companyos-artifacts

# Required: session signing secret and Fernet key(s) for tenant secrets (comma-separated, first encrypts)
SECRET_KEY=
ENCRYPTION_KEYS=

# Email: smtp (Mailpit locally, http://localhost:8025) or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=CompanyOS <notifications@companyos.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Each organization configures its own AI key in Settings > AI Provider.
# Optional dev-only fallback key (never used in production):
ALLOW_PLATFORM_AI_FALLBACK=false
PLATFORM_AI_API_KEY=

# Emails that become platform administrators on signup
PLATFORM_ADMIN_EMAILS=[]
